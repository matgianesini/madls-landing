//
// Episode Six
//

// Las 8 paredes forman un octágono regular alrededor del usuario
// (el centro de giro de la escena). Cada pared está a la distancia
// que antes tenía front; las paredes laterales reparten el panorama
// de wall-left / wall-right en tres tramos continuos.
:root
	--scene6-times 1.5
	--scene6-apotema calc( 8190px * var(--scene6-times) ) // distancia del centro a cada pared
	--scene6-lado calc( var(--scene6-apotema) * 0.828427 ) // 2 · tan(22.5°)
	--scene6-traslape 2px // ancho extra (antes de scale(4)) para que las esquinas no dejen ver una línea negra
	--scene6-alto calc( 1296px * var(--scene6-times) ) // alto antes de scale(4)
	--scene6-centro-y -838px // altura del centro de las paredes (la que tenía front)


.esc-6--ceiling
.esc-6--front
.esc-6--back
.esc-6--background-front
.esc-6--wall-left
.esc-6--wall-right
.esc-6--wall-left-2
.esc-6--wall-right-2
.esc-6--wall-left-3
.esc-6--wall-right-3
.esc-6--intro
	position: absolute
	top: calc( -540px * var(--scene6-times))
	left: calc( -960px * var(--scene6-times))
	z-index 1

// Cada pared se centra en el origen, gira hacia su lado del octágono
// y se aleja la apotema
.esc-6--front
.esc-6--back
.esc-6--wall-left
.esc-6--wall-right
.esc-6--wall-left-2
.esc-6--wall-right-2
.esc-6--wall-left-3
.esc-6--wall-right-3
	--angulo 0deg
	width: calc( var(--scene6-lado) / 4 + var(--scene6-traslape) )
	height: var(--scene6-alto)
	left: calc( var(--scene6-lado) / -8 - var(--scene6-traslape) / 2 )
	top: calc( var(--scene6-alto) / -2 )
	transform: translateY(var(--scene6-centro-y)) rotateY(var(--angulo)) translateZ(calc( var(--scene6-apotema) * -1 )) scale(4)
	// opacity 0.8

.esc-6--front
	background url(../assets/imgs/esc-6--front.webp) no-repeat center center / cover

.esc-6--back
	--angulo 180deg
	background url(../assets/imgs/esc-6--back.webp) no-repeat center center / cover

// Panorama: el tramo 0% queda junto a back y el 100% junto a front (izquierda),
// y al revés del lado derecho
.esc-6--wall-left
.esc-6--wall-left-2
.esc-6--wall-left-3
	background url(../assets/imgs/esc-6--wall-left.webp) no-repeat 0% 50% / 300% auto

.esc-6--wall-right
.esc-6--wall-right-2
.esc-6--wall-right-3
	background url(../assets/imgs/esc-6--wall-right.jpg) no-repeat 0% 50% / 300% auto

.esc-6--wall-left
	--angulo 45deg
	background-position-x 100%

.esc-6--wall-left-2
	--angulo 90deg
	background-position-x 50%

.esc-6--wall-left-3
	--angulo 135deg
	background-position-x 0%

.esc-6--wall-right
	--angulo -45deg
	background-position-x 0%

.esc-6--wall-right-2
	--angulo -90deg
	background-position-x 50%

.esc-6--wall-right-3
	--angulo -135deg
	background-position-x 100%

// Techo y piso cubren el octágono (2 × apotema) y quedan en el borde
// superior e inferior de las paredes
.esc-6--floor
.esc-6--ceiling
	position: absolute
	width: calc( var(--scene6-apotema) / 6.4 )
	height: calc( var(--scene6-apotema) / 6.4 )
	left: calc( var(--scene6-apotema) / -12.8 )
	top: calc( var(--scene6-apotema) / -12.8 )
	z-index 1

.esc-6--floor
	background url(../assets/imgs/esc-6--floor.webp) no-repeat center center / cover
	transform: translateY(calc( var(--scene6-centro-y) + var(--scene6-alto) * 2 )) rotateX(90deg) scale(12.8)

.esc-6--ceiling
	background url(../assets/imgs/esc-6--ceiling.jpg) no-repeat center center
	background-size 100% 100%
	transform: translateY(calc( var(--scene6-centro-y) - var(--scene6-alto) * 2 )) rotateX(90deg) scale(12.8)

.esc-6--intro
	width: 700px
	height: 600px
	transform: rotateY(90deg) translateZ(-1900px) translate(650px, 150px)
	left: 695px

